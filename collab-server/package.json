{
  "name": "noteser-collab-server",
  "version": "0.1.0",
  "private": true,
  "description": "y-websocket-compatible live-collaboration server for noteser, running on Cloudflare Workers + Durable Objects.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir=dist"
  },
  "dependencies": {
    "lib0": "^0.2.99",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "undici": "^7.29.0",
    "esbuild": "^0.28.1",
    "sharp": "^0.35.0",
    "postcss": "^8.5.18",
    "nanoid": "^3.3.17"
  }
}
